# Copy to .env.local for local development. In GitHub Actions / Netlify these
# come from repository secrets / site environment variables.
# The anon (publishable) key is safe to ship to browsers — access is enforced
# by row level security in the database. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
